# Firebase web app configuration.
# Copy this file to `.env` and fill in your project's values.
# These values come from Firebase console -> Project settings -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Optional: only set this if App Check is ENFORCED on Cloud Firestore.
# reCAPTCHA v3 site key from Firebase console -> App Check -> Apps -> (web app).
# Leave empty/unset for local dev or when App Check is not enforced.
VITE_FIREBASE_APPCHECK_SITE_KEY=
