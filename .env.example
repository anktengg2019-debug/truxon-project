# ---------------------------------------------------------------------------
# CLIENT (Vite) — Firebase web app config. Copy this file to `.env`.
# Firebase console → Project settings → Your apps → SDK setup and configuration.
# These ship in the client bundle (not secrets), but `.env` is git-ignored.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# SERVER (Vercel serverless functions, api/auth/*) — Email OTP backend.
# These ARE secrets: set them as Environment Variables in Vercel (and in a local
# `.env` only for local `vercel dev`). Never commit real values.
# ---------------------------------------------------------------------------

# Firebase Admin service account used to mint custom tokens + write hashed OTPs.
# Paste the full service account JSON on one line, or base64-encode it.
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# SMTP for sending the 6-digit code (Gmail app password, SendGrid, Mailgun, SES…).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=Truxon <you@example.com>
