rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True for any signed-in user who has a profile document. Uses exists() so the
    // rule never crashes when the doc (or role field) is missing — it just returns false.
    function isOps() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Each user owns their own profile doc. This bootstrap rule lets a freshly
    // signed-in client self-create users/{uid} (with a default role) so that
    // isOps()/isAdmin() can subsequently evaluate. Admins can read any profile.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Clients may only create their profile with the default role and may never
      // self-escalate it (role must stay the same, or be backfilled from missing to
      // 'user'). Elevating to 'admin' is done out-of-band (console / Admin SDK).
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == resource.data.role
            || (resource.data.role == null && request.resource.data.role == 'user'));
      allow delete: if isAdmin();
    }

    // Live driver positions: any provisioned (ops) user can read the fleet and
    // write positions. Tighten to `request.auth.uid == driverId` if each driver
    // should only write their own doc.
    match /drivers/{driverId} {
      allow read: if isOps();
      allow write: if isOps();
    }
  }
}
