rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Any signed-in user who has a profile document. exists() keeps the rule from
    // crashing when the doc is missing — it just returns false.
    function isOps() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roles) {
      return isOps() && profile().role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    // Roles a client may self-assign at signup (never 'admin').
    function selfAssignableRole(role) {
      return role in ['customer', 'transporter', 'vendor', 'driver'];
    }

    // Each user owns their own profile doc.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Self-create with a non-admin role only.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && selfAssignableRole(request.resource.data.role);
      // Owner may update their profile but never change their own role
      // (privilege changes happen out-of-band: Admin SDK / console).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Live driver positions: any provisioned user can read the fleet; only
    // transporter/vendor/driver/admin may write positions.
    match /drivers/{driverId} {
      allow read: if isOps();
      allow write: if hasRole(['transporter', 'vendor', 'driver', 'admin']);
    }

    // Customer bookings: a signed-in customer creates bookings they own; the
    // owner (or an admin) can read/update them. Admins can read every booking.
    match /bookings/{bookingId} {
      allow read: if isOps() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isOps() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOps() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Load marketplace: any provisioned user can browse open loads; only
    // customers/vendors/admins may post loads they own. The owner (or an admin)
    // can update/delete; any bidder may only bump bidCount/updatedAt when bidding.
    match /loads/{loadId} {
      allow read: if isOps();
      allow create: if hasRole(['customer', 'vendor', 'admin'])
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isOps() && (
        resource.data.customerId == request.auth.uid || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['bidCount', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Bids: transporters/drivers create bids they own. The bidder, the owner of
    // the target load, or an admin can read; the load owner / admin update
    // (accept/reject) bids.
    match /bids/{bidId} {
      allow read: if isOps() && (
        resource.data.transporterId == request.auth.uid
        || get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.customerId == request.auth.uid
        || isAdmin()
      );
      allow create: if hasRole(['transporter', 'driver', 'admin'])
        && request.resource.data.transporterId == request.auth.uid;
      allow update: if isOps() && (
        get(/databases/$(database)/documents/loads/$(resource.data.loadId)).data.customerId == request.auth.uid
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Wallets: each user owns their wallet; admins may adjust the balance when
    // confirming a UPI top-up.
    match /wallets/{walletId} {
      allow read: if isOps() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOps() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isOps() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Transactions: the owner creates + reads their own; owner/admin may update
    // (mark completed/failed on confirmation).
    match /transactions/{txnId} {
      allow read: if isOps() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOps() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isOps() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Email OTP material is written/read only by the server (Admin SDK), which
    // bypasses these rules. Clients must never touch it.
    match /emailOtps/{docId} {
      allow read, write: if false;
    }
  }
}
